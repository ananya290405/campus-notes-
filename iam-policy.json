{
  "Version": "2012-10-17",
  "Statement": [
    {"Effect": "Allow",
     "Action": ["s3:PutObject", "s3:GetObject"],
     "Resource": "arn:aws:s3:::CHANGE-ME-BUCKET-NAME/*"},
    {"Effect": "Allow",
     "Action": ["dynamodb:PutItem", "dynamodb:Scan", "dynamodb:GetItem"],
     "Resource": "arn:aws:dynamodb:ap-south-1:CHANGE-ME-ACCOUNT-ID:table/CampusNotes"}
  ]
}
